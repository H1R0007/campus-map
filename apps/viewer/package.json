{
  "name": "@campus-map/viewer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc && vite build",
    "dev": "vite",
    "typecheck": "tsc",
    "lint": "eslint src tests vite.config.ts",
    "test": "vitest run && node ../../tooling/verify-dist-data.mjs --app viewer && node ../../tooling/smoke-test.mjs --app viewer --mode prod",
    "test:watch": "vitest",
    "preview": "vite preview",
    "clean": "node ../../tooling/clean.mjs dist \"*.tsbuildinfo\""
  },
  "dependencies": {
    "@campus-map/core": "workspace:*",
    "@campus-map/mapkit": "workspace:*",
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.8",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vite-plugin-pwa": "^0.20.0",
    "vitest": "^2.1.0"
  }
}
