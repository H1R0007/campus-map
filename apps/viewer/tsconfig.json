{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false
  },
  // `tests` включён намеренно: иначе тесты не проверяются типами вообще —
  // vitest транспилирует их без проверки, и ошибка в тесте становится видна
  // только когда он падает по непонятной причине.
  "include": ["src", "tests"],
  "exclude": ["node_modules", "dist"]
}
