{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false
  },
  // `tests` включён намеренно: vitest транспилирует тесты без проверки типов.
  "include": ["src", "tests"],
  "exclude": ["node_modules", "dist"]
}
