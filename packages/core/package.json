{
  "name": "@campus-map/core",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "typecheck": "tsc --build && tsc -p tsconfig.test.json",
    "lint": "eslint src tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "node ../../tooling/clean.mjs dist \"*.tsbuildinfo\""
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "description": "Доменная логика кампуса: датасет, граф, поиск маршрутов"
}
