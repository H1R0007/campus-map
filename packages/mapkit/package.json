{
  "name": "@campus-map/mapkit",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Общая обвязка Leaflet-карты для навигатора и редактора",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "typecheck": "tsc --build",
    "lint": "eslint src",
    "clean": "node ../../tooling/clean.mjs dist \"*.tsbuildinfo\""
  },
  "peerDependencies": {
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.8",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "typescript": "^5.4.0"
  }
}
