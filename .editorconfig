# EditorConfig — https://editorconfig.org
# Единые правила оформления для всех участников проекта.
# Критично: charset = utf-8 prevents the CP1251 regression that corrupted
# 23 source files and leaked mojibake into user-visible strings.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{json,yml,yaml}]
indent_size = 2

[Makefile]
indent_style = tab
